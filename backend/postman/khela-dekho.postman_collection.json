              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Create a new user account with a **username**, **email**, and **password**. Both username and email must be unique. The password is hashed before storage. After registering, call `/api/auth/login` with the same email and password to obtain access and refresh tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Username\",\n  \"email\": \"tester@example.com\",\n  \"password\": \"securepassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ok = pm.response.code >= 200 && pm.response.code < 300;",
                  "pm.test('auth request succeeded', () => pm.expect(ok).to.be.true);",
                  "if (ok) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) {",
                  "    pm.environment.set('access_token', data.access_token);",
                  "    console.log('access_token saved to environment');",
                  "  }",
                  "  if (data.refresh_token) {",
                  "    pm.environment.set('refresh_token', data.refresh_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
